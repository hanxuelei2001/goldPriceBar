<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingTop="6dp"
    android:paddingEnd="2dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/status_arrow_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:text="@string/status_placeholder"
        android:textColor="@color/trend_neutral"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/chip_compact_zhe_shang"
        style="@style/NotificationChip"
        android:text="@string/provider_zhe_shang" />

    <TextView
        android:id="@+id/chip_compact_min_sheng"
        style="@style/NotificationChip"
        android:text="@string/provider_min_sheng" />

    <TextView
        android:id="@+id/chip_compact_gong_shang"
        style="@style/NotificationChip"
        android:text="@string/provider_gong_shang" />

</LinearLayout>
